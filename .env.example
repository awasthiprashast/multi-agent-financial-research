# Copy this file to `.env` and fill in the values you need. `.env` is git-ignored.
# Never commit real keys. Variables already set in your shell take priority.

# --- LLM analysts (optional; the app works without any of these) -------------
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Groq model (default: openai/gpt-oss-120b). Groq retires models; if you get a
# "model_not_found" error, pick one your key can use, e.g. openai/gpt-oss-20b.
GROQ_MODEL=
# Force a backend: groq | ollama | none   (default: groq if a key is set, else ollama)
FINRESEARCH_LLM=
# Local Ollama model name (default: first installed model)
OLLAMA_MODEL=
# Sampling seed for reproducible LLM evaluation runs
FINRESEARCH_LLM_SEED=7

# --- Model backends ----------------------------------------------------------
# tfidf | neural | auto      (tfidf is deterministic and needs no download)
FINRESEARCH_EMBEDDER=auto
# lexicon | finbert | auto
FINRESEARCH_SCORER=auto

# --- API ---------------------------------------------------------------------
# template | llm | auto
FINRESEARCH_ANALYSTS=template
# Comma-separated browser origins allowed to call the API
FINRESEARCH_CORS=http://localhost:8501,http://127.0.0.1:8501
